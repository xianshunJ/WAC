{
  "manifest_version": 3,
  "name": "WAC · Workload Aware Calendar",
  "version": "0.1.3",
  "description": "See the effort behind your deadlines. Estimate assignments, plan work blocks, and connect Google Calendar.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel", "identity"],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://calendar.google.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open WAC",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://calendar.google.com/*"],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' https://www.googleapis.com http://127.0.0.1:8787"
  },
  "key": "",
  "oauth2": {
    "client_id": "215582053413-3ebnsgl0q85t0l6q8qln5skqbq8ump9q.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.events",
      "https://www.googleapis.com/auth/calendar.events.freebusy"
    ]
  }
}

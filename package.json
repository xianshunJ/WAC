{
  "name": "workload-aware-calendar",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "WAC Chrome extension and local assignment-analysis service for an HCI course project.",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xianshunJ/WAC.git"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:features": "node scripts/features-smoke.mjs",
    "check": "node scripts/check.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "verify": "npm run format:check && npm run check && npm test",
    "configure": "node scripts/configure-oauth.mjs",
    "configure:analysis": "node scripts/configure-analysis.mjs",
    "package:webstore": "node scripts/package-webstore.mjs",
    "analysis": "node backend/server.mjs",
    "analysis:demo": "node backend/server.mjs --demo",
    "analysis:env": "node --env-file=.env backend/server.mjs",
    "preview": "node scripts/preview.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "prettier": "3.9.10"
  }
}
